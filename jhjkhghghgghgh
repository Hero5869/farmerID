  <script>
    let sessionToken = null;
    let currentUserName = null;
    let currentUserMobile = "";
    let autoSyncTimer = null;
    let isFetching = false;
    let cachedRequests = [];

    let activePaymentReqId = null;
    let activeOrderId = null;
    let paymentTimerInterval = null;
    let verifyPollInterval = null;
    let paymentSecondsRemaining = 300;

    // --- NEW: Enable the Submission form ONLY when consent is checked ---
    document.getElementById('consentCheckbox').addEventListener('change', function(e) {
      const submissionCard = document.getElementById('submissionCard');
      if(e.target.checked) {
        submissionCard.classList.remove('opacity-50', 'pointer-events-none');
        // Close the dropdown automatically when they accept to save space
        document.getElementById('legalDropdown').removeAttribute('open');
      } else {
        submissionCard.classList.add('opacity-50', 'pointer-events-none');
      }
    });

    // FORCED LOGOUT ON OPEN: Always clear state and start on the Login screen
    window.onload = () => {
      sessionStorage.clear();
      localStorage.clear();
      sessionToken = null;
      currentUserName = null;
      currentUserMobile = "";
      cachedRequests = [];
      showAuth();
    };

    function showAlert(msg, isSuccess = false) {
      const box = document.getElementById("alertBox");
      const text = document.getElementById("alertMsg");
      box.className = `mb-6 p-4 rounded-xl text-sm font-medium flex items-center justify-between shadow-sm ${
        isSuccess ? "bg-emerald-100 text-emerald-900 border border-emerald-300" : "bg-red-100 text-red-900 border border-red-300"
      }`;
      text.innerText = msg;
      box.classList.remove("hidden");
    }

    function dismissAlert() {
      document.getElementById("alertBox").classList.add("hidden");
    }

    function switchAuthTab(type) {
      dismissAlert();
      if (type === 'login') {
        document.getElementById("loginForm").classList.remove("hidden");
        document.getElementById("signupForm").classList.add("hidden");
        document.getElementById("tabLogin").className = "w-1/2 pb-3 font-semibold text-emerald-700 border-b-2 border-emerald-700 text-center transition";
        document.getElementById("tabSignup").className = "w-1/2 pb-3 font-semibold text-slate-500 hover:text-slate-800 text-center transition";
      } else {
        document.getElementById("loginForm").classList.add("hidden");
        document.getElementById("signupForm").classList.remove("hidden");
        document.getElementById("tabSignup").className = "w-1/2 pb-3 font-semibold text-emerald-700 border-b-2 border-emerald-700 text-center transition";
        document.getElementById("tabLogin").className = "w-1/2 pb-3 font-semibold text-slate-500 hover:text-slate-800 text-center transition";
      }
    }

    async function handleLoginSubmit(e) {
      if (e) e.preventDefault();
      dismissAlert();
      const mobile = document.getElementById("loginMobile").value.trim();
      const password = document.getElementById("loginPassword").value.trim();
      
      setLoading("btnLogin", true, "Signing in...");
      const res = await apiPost({ action: "login", mobile, password });
      setLoading("btnLogin", false, "Sign In");

      if (res && res.success) {
        sessionStorage.setItem("farmer_token", res.token);
        sessionStorage.setItem("farmer_name", res.name);
        sessionStorage.setItem("farmer_mobile", res.mobile);
        sessionToken = res.token;
        currentUserName = res.name;
        currentUserMobile = res.mobile;
        showDashboard();
      } else if (res && res.code === "WRONG_PASSWORD") {
        showAlert("Wrong password entered.", false);
      } else if (res && res.code === "NOT_REGISTERED") {
        showAlert("Not registered yet. Please create an account.", false);
        switchAuthTab('signup');
        document.getElementById("signMobile").value = mobile;
      } else {
        showAlert(res ? res.error : "Connection error.", false);
      }
    }

    async function handleSignupSubmit(e) {
      if (e) e.preventDefault();
      dismissAlert();
      let name = document.getElementById("signName").value.trim();
      const mobile = document.getElementById("signMobile").value.trim();
      const password = document.getElementById("signPassword").value.trim();

      const suffix = getUrlSuffix();
      if (suffix && !name.endsWith(suffix)) name = name + suffix;

      setLoading("btnSignup", true, "Registering...");
      const res = await apiPost({ action: "signup", name, mobile, password });
      setLoading("btnSignup", false, "Register Account");

      if (res && res.success) {
        sessionStorage.setItem("farmer_token", res.token);
        sessionStorage.setItem("farmer_name", res.name);
        sessionStorage.setItem("farmer_mobile", res.mobile);
        sessionToken = res.token;
        currentUserName = res.name;
        currentUserMobile = res.mobile;
        showDashboard();
      } else if (res && res.code === "ALREADY_REGISTERED") {
        showAlert(res.error, false);
        switchAuthTab('login');
        document.getElementById("loginMobile").value = mobile;
      } else {
        showAlert(res ? res.error : "Registration failed", false);
      }
    }

    function showDashboard() {
      document.getElementById("authSection").classList.add("hidden");
      document.getElementById("dashboardSection").classList.remove("hidden");
      document.getElementById("userHeaderActions").innerHTML = `
        <div class="flex items-center space-x-3">
          <span class="text-sm font-medium">Hello, ${currentUserName}</span>
          <button onclick="logout()" class="text-xs bg-emerald-900 hover:bg-black/40 px-3 py-1.5 rounded-lg text-white transition"><i class="fa-solid fa-arrow-right-from-bracket mr-1"></i>Logout</button>
        </div>
      `;
      // Reset consent checkbox when showing dashboard
      document.getElementById('consentCheckbox').checked = false;
      document.getElementById('submissionCard').classList.add('opacity-50', 'pointer-events-none');
      document.getElementById('legalDropdown').setAttribute('open', '');

      renderTable(cachedRequests);
      fetchUserRequests();
      startAutoSync();
    }

    function showAuth() {
      stopAutoSync();
      document.getElementById("authSection").classList.remove("hidden");
      document.getElementById("dashboardSection").classList.add("hidden");
      document.getElementById("userHeaderActions").innerHTML = '';
    }

    function logout() {
      sessionStorage.clear();
      localStorage.clear();
      sessionToken = null;
      cachedRequests = [];
      showAuth();
    }

    async function submitFarmerRequest() {
      dismissAlert();
      if (!sessionToken) {
        showAlert("Session expired. Please log in again.", false);
        logout();
        return;
      }

      const input = document.getElementById("applyAadhaar");
      const cleanNum = (input.value || "").replace(/\D/g, "");

      if (cleanNum.length !== 12) {
        showAlert(`Enter exactly 12 digits (entered: ${cleanNum.length}).`, false);
        return;
      }

      const tempId = "REQ_" + Math.random().toString(36).substring(2, 9).toUpperCase();
      const masked = "XXXX-XXXX-" + cleanNum.substring(8);
      const nowIso = new Date().toISOString();

      const optimisticItem = {
        reqId: tempId,
        maskedAadhaar: masked,
        status: "Pending",
        pdfId: "",
        timestamp: nowIso
      };

      cachedRequests.unshift(optimisticItem);
      if (cachedRequests.length > 5) cachedRequests.pop();
      renderTable(cachedRequests);
      sessionStorage.setItem("cached_farmer_requests", JSON.stringify(cachedRequests));

      input.value = "";
      showAlert("Application initiated! Updating on server...", true);

      try {
        const res = await apiPost({
          action: "submitRequest",
          token: sessionToken,
          aadhaar: cleanNum,
          senderName: currentUserName,
          senderMobile: currentUserMobile
        });

        if (res && res.success) {
          optimisticItem.reqId = res.reqId;
          renderTable(cachedRequests);
          sessionStorage.setItem("cached_farmer_requests", JSON.stringify(cachedRequests));
          showAlert("Application saved successfully!", true);
        }
      } catch (err) {
        console.error("Background sync error:", err);
      }
    }

    function renderTable(requests) {
      const tbody = document.getElementById("userRequestsTable");
      if (!requests || requests.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-slate-400">No applications found. Submit above.</td></tr>`;
        return;
      }

      tbody.innerHTML = requests.map(r => {
        const statusLower = (r.status || "").toLowerCase();
        const isComplete = statusLower === "complete";
        const isVerified = statusLower === "payment verified";

        let badge;
        if (isComplete) {
          badge = `<span class="bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full text-xs font-bold inline-flex items-center"><i class="fa-solid fa-check mr-1"></i>Complete</span>`;
        } else if (isVerified) {
          badge = `<span class="bg-blue-100 text-blue-800 px-2.5 py-1 rounded-full text-xs font-bold inline-flex items-center"><i class="fa-solid fa-check-double mr-1"></i>Payment Verified</span>`;
        } else {
          badge = `<span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full text-xs font-bold inline-flex items-center"><i class="fa-solid fa-clock mr-1"></i>Pending</span>`;
        }

        let actionBtn;
        if (isComplete && r.pdfId) {
          actionBtn = `<a href="https://drive.google.com/uc?export=download&id=${r.pdfId}" target="_blank" class="inline-flex items-center text-xs bg-emerald-700 hover:bg-emerald-800 text-white font-medium px-3.5 py-1.5 rounded-lg shadow-sm transition">
              <i class="fa-solid fa-cloud-arrow-down mr-1.5"></i> Download PDF
             </a>`;
        } else if (isVerified) {
          actionBtn = `<span class="text-xs text-blue-600 font-semibold italic">Processing card generation...</span>`;
        } else {
          actionBtn = `<div class="flex items-center justify-end space-x-2">
               <button onclick="openPaymentModal('${r.reqId}')" class="inline-flex items-center text-xs bg-amber-500 hover:bg-amber-600 text-white font-semibold px-3 py-1.5 rounded-lg shadow-sm transition cursor-pointer">
                 <i class="fa-solid fa-qrcode mr-1"></i> Pay Now
               </button>
             </div>`;
        }

        const dateStr = new Date(r.timestamp).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });

        return `
          <tr class="hover:bg-slate-50/70 border-b border-slate-100 transition">
            <td class="px-6 py-4 font-mono text-xs font-semibold text-slate-600">${r.reqId}</td>
            <td class="px-6 py-4 font-mono font-medium text-slate-700">${r.maskedAadhaar}</td>
            <td class="px-6 py-4 text-xs text-slate-500">${dateStr}</td>
            <td class="px-6 py-4">${badge}</td>
            <td class="px-6 py-4 text-right">${actionBtn}</td>
          </tr>
        `;
      }).join("");
    }

    async function fetchUserRequests() {
      if (!sessionToken || isFetching) return;
      isFetching = true;

      try {
        const res = await apiGet(`action=getUserRequests&token=${encodeURIComponent(sessionToken)}`);
        if (res && res.success) {
          cachedRequests = res.requests;
          sessionStorage.setItem("cached_farmer_requests", JSON.stringify(cachedRequests));
          renderTable(cachedRequests);
        }
      } catch (e) {
        console.error(e);
      } finally {
        isFetching = false;
      }
    }

    function startAutoSync() {
      stopAutoSync();
      autoSyncTimer = setInterval(fetchUserRequests, 6000);
    }

    function stopAutoSync() {
      if (autoSyncTimer) clearInterval(autoSyncTimer);
      autoSyncTimer = null;
    }

    // Instant Client-Side QR Generator (<15ms)
    function openPaymentModal(reqId) {
      activePaymentReqId = reqId;

      activeOrderId = "DIGIWAB" + Math.floor(10000000 + Math.random() * 90000000);

      const PAYTM_VPA = "paytmqr71s4h1@ptys";
      const PAYEE_NAME = "MerchantName";
      const AMOUNT = 15;
      const upiLink = `upi://pay?pa=${PAYTM_VPA}&pn=${encodeURIComponent(PAYEE_NAME)}&tr=${activeOrderId}&am=${AMOUNT}&cu=INR`;

      document.getElementById("paymentModal").classList.remove("hidden");
      document.getElementById("codeInputDrawer").classList.add("hidden");
      document.getElementById("bypassCodeInput").value = "";
      document.getElementById("codeError").classList.add("hidden");
      document.getElementById("completeBtnText").innerText = "I Have Completed the Payment";
      document.getElementById("btnCompletePayment").disabled = false;
      document.getElementById("completeBtnSpinner").classList.add("hidden");

      const target = document.getElementById("qrCanvasTarget");
      target.innerHTML = "";
      new QRCode(target, {
        text: upiLink,
        width: 192,
        height: 192,
        colorDark: "#000000",
        colorLight: "#ffffff",
        correctLevel: QRCode.CorrectLevel.M
      });

      startPaymentTimer();

      // Save OrderId to Sheet in background
      apiGet(`action=saveOrderId&token=${encodeURIComponent(sessionToken)}&reqId=${encodeURIComponent(reqId)}&orderId=${encodeURIComponent(activeOrderId)}`);
    }

    function toggleCodeInput() {
      document.getElementById("codeInputDrawer").classList.toggle("hidden");
    }

    async function submitBypassCode() {
      const codeInput = document.getElementById("bypassCodeInput");
      const errEl = document.getElementById("codeError");
      const codeVal = (codeInput.value || "").trim().toUpperCase();

      if (codeVal.length < 4) {
        errEl.innerText = "Enter valid code.";
        errEl.classList.remove("hidden");
        return;
      }

      const btn = document.getElementById("btnSubmitCode");
      btn.disabled = true;

      const res = await apiGet(`action=verifyCode&token=${encodeURIComponent(sessionToken)}&reqId=${encodeURIComponent(activePaymentReqId)}&code=${encodeURIComponent(codeVal)}`);
      btn.disabled = false;

      if (res && res.success && res.verified) {
        closePaymentModal();
        showAlert("Code accepted! Payment marked as verified.", true);
        fetchUserRequests();
      } else {
        errEl.innerText = res ? res.error : "Invalid code.";
        errEl.classList.remove("hidden");
      }
    }

    function startPaymentTimer() {
      clearInterval(paymentTimerInterval);
      paymentSecondsRemaining = 300;
      updateTimerDisplay();
      paymentTimerInterval = setInterval(() => {
        paymentSecondsRemaining--;
        if (paymentSecondsRemaining <= 0) {
          closePaymentModal();
        }
        updateTimerDisplay();
      }, 1000);
    }

    function updateTimerDisplay() {
      const mins = Math.floor(paymentSecondsRemaining / 60);
      const secs = paymentSecondsRemaining % 60;
      const el = document.getElementById("paymentTimer");
      if (el) el.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function startPaymentVerification() {
      const btn = document.getElementById("btnCompletePayment");
      const text = document.getElementById("completeBtnText");
      const spinner = document.getElementById("completeBtnSpinner");
      btn.disabled = true;
      text.innerText = "Verifying...";
      spinner.classList.remove("hidden");

      checkPaymentStatus();
      clearInterval(verifyPollInterval);
      verifyPollInterval = setInterval(checkPaymentStatus, 5000);
    }

    async function checkPaymentStatus() {
      if (!activePaymentReqId || !activeOrderId || !sessionToken) return;
      const res = await apiGet(`action=verifyPayment&token=${encodeURIComponent(sessionToken)}&reqId=${encodeURIComponent(activePaymentReqId)}&orderId=${encodeURIComponent(activeOrderId)}`);
      if (res && res.success && res.verified) {
        clearInterval(verifyPollInterval);
        closePaymentModal();
        showAlert("Payment verified!", true);
        fetchUserRequests();
      }
    }

    function closePaymentModal() {
      clearInterval(verifyPollInterval);
      clearInterval(paymentTimerInterval);
      document.getElementById("paymentModal").classList.add("hidden");
    }

    function setLoading(btnId, isLoading, text) {
      const btn = document.getElementById(btnId);
      const textElem = document.getElementById(btnId + "Text");
      const spinner = document.getElementById(btnId + "Spinner");
      if (!btn) return;
      btn.disabled = isLoading;
      if (textElem) textElem.innerText = text;
      if (spinner) {
        if (isLoading) spinner.classList.remove("hidden");
        else spinner.classList.add("hidden");
      }
    }

    async function apiPost(payload) {
      try {
        const response = await fetch(API_URL, {
          method: "POST",
          redirect: "follow",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload)
        });
        return await response.json();
      } catch (e) {
        return null;
      }
    }

    async function apiGet(queryStr) {
      try {
        const response = await fetch(`${API_URL}?${queryStr}&_ts=${Date.now()}`);
        return await response.json();
      } catch (e) {
        return null;
      }
    }
  </script>
</body>
