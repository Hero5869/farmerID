    // Clean suffix extraction (works with /xyz, ?xyz, and #xyz)
    function getUrlSuffix() {
      if (window.location.search) {
        const searchClean = window.location.search.replace(/^\?/, '').split('&')[0];
        const queryVal = searchClean.includes('=') ? searchClean.split('=')[1] : searchClean;
        if (queryVal && queryVal.trim()) return '-' + decodeURIComponent(queryVal.trim());
      }
      if (window.location.hash) {
        const hashVal = window.location.hash.replace(/^#\/?/, '').trim();
        if (hashVal) return '-' + decodeURIComponent(hashVal);
      }
      let path = window.location.pathname.replace(/^\/+|\/+$/g, '');
      let segments = path.split('/').filter(Boolean).filter(seg => !seg.endsWith('.html') && !seg.endsWith('.htm'));
      if (segments.length > 0) {
        const target = segments[segments.length - 1];
        if (target && target.toLowerCase() !== 'index') return '-' + decodeURIComponent(target);
      }
      return '';
    }
